# Mẫu cấu hình. Sao chép thành `.env` (đã nằm trong .gitignore) và điền giá trị thật.
# KHÔNG commit khóa thật vào file này.

# Môi trường: dev | test | prod (mặc định dev)
APP_ENV=dev

# Cổng SMS (bắt buộc ở mọi môi trường)
SMS_API_URL=https://sms-gateway.example.invalid/api
SMS_API_KEY=changeme

# Tùy chọn ở dev/test (có mặc định); BẮT BUỘC ở prod (DATABASE_URL)
# DATABASE_URL=postgresql://app:app@127.0.0.1:5442/app
# LOG_LEVEL=DEBUG
